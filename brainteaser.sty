\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{brainteaser}[2026/10/16 Style feuille d'exercices]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[french]{babel}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[a4paper,margin=27mm,headheight=14pt,footskip=10mm]{geometry}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}

% Une seule couleur d'accent, proche des annotations d'une feuille de cours.
\definecolor{btRed}{HTML}{A31E2D}
\definecolor{btDark}{HTML}{202124}
\definecolor{btGray}{HTML}{666666}

\hypersetup{
  colorlinks=true,
  linkcolor=btRed,
  urlcolor=btRed,
  pdfborder={0 0 0},
  pdfdisplaydoctitle=true
}

\color{btDark}
\setlength{\parindent}{1.35em}
\setlength{\parskip}{0pt}
\setlength{\abovedisplayskip}{8pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{8pt plus 2pt minus 2pt}
\setlist{leftmargin=1.8em,itemsep=2.5pt,topsep=4pt,parsep=0pt}
\allowdisplaybreaks
\raggedbottom
\emergencystretch=2em

\newcommand{\BTTitle}{Brainteaser}
\newcommand{\BTNumber}{}
\newcommand{\brainteasertitle}[2]{%
  \renewcommand{\BTNumber}{#1}%
  \renewcommand{\BTTitle}{#2}%
  \hypersetup{pdftitle={Brainteaser #1 - #2},pdfauthor={Thibault Perret},pdfsubject={Feuille d'exercices}}%
  \thispagestyle{empty}%
  \begin{center}
    {\large\scshape Brainteaser #1\par}
    \vspace{2.5mm}
    {\LARGE\bfseries #2\par}
  \end{center}
  \vspace{3mm}
  \noindent\textcolor{btRed}{\rule{\textwidth}{0.55pt}}
  \vspace{4mm}
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

\newcommand{\btlabel}[1]{\textcolor{btRed}{\bfseries #1}}
\newcommand{\important}[1]{\textcolor{btRed}{\bfseries #1}}
\newcommand{\hypothesis}[1]{%
  \par\smallskip\noindent\btlabel{Hypothèse.}\enspace\emph{#1}\par\smallskip
}

% Les anciens noms d'environnements sont conservés pour ne pas alourdir
% les fichiers d'exercices, mais ils ne dessinent plus aucune boîte.
\newenvironment{statementbox}{%
  \par\addvspace{0.7\baselineskip}%
  \noindent\btlabel{Énoncé.}\enspace\ignorespaces
}{%
  \par\addvspace{0.55\baselineskip}%
}

\newenvironment{hintsbox}{%
  \par\addvspace{0.9\baselineskip}%
  \noindent\btlabel{Indications.}\par\nobreak\smallskip\ignorespaces
}{%
  \par\addvspace{0.55\baselineskip}%
}

\newenvironment{keyideabox}{%
  \par\addvspace{0.9\baselineskip}%
  \noindent\btlabel{Idée clé.}\enspace
  \begingroup\itshape\ignorespaces
}{%
  \par\endgroup\addvspace{0.55\baselineskip}%
}

\newenvironment{resultbox}{%
  \par\addvspace{1.05\baselineskip}%
  \noindent\btlabel{Résultat.}\par\nobreak\smallskip
  \begingroup\bfseries\ignorespaces
}{%
  \par\endgroup
  \noindent\textcolor{btRed}{\rule{0.28\textwidth}{0.45pt}}%
  \par\addvspace{0.55\baselineskip}%
}

\newcommand{\correction}{%
  \clearpage
  \thispagestyle{fancy}%
  \vspace*{3mm}%
  \begin{center}
    {\Large\bfseries Correction\par}
  \end{center}
  \vspace{1mm}
  \noindent\textcolor{btRed}{\rule{\textwidth}{0.55pt}}
  \vspace{4mm}
  \addcontentsline{toc}{section}{Correction}%
}

\newcommand{\Pp}{\mathbb P}
\newcommand{\E}{\mathbb E}

\AtBeginDocument{\frenchsetup{StandardLists=true}}
